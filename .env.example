# Nastavení serveru Goralia. Zkopíruj do .env (ten je v .gitignore) a doplň hodnoty:
#   cp .env.example .env
# Server ho načte při startu z kořene projektu (nezáleží na složce, odkud ho spouštíš).
# Proměnné nastavené v prostředí (např. `PORT=3100 pm2 start ...`) mají přednost před .env.
# Po změně .env stačí: pm2 restart goralia (v Dockeru: docker compose up -d)

# Port HTTP serveru (výchozí 3000; v Dockeru ho určuje docker-compose.yml, vždy 3000, tady ho můžeš smazat)
PORT=3100
# Veřejná adresa webu, z ní se skládají OAuth callbacky (https://goralia.cz/auth/google/callback)
PUBLIC_URL=https://goralia.cz

# Přihlášení přes Google (Google Cloud Console, OAuth client ID typu Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Přihlášení přes Facebook (aplikace s Facebook Login v režimu Live)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Admin: jméno, e-mail a heslo při prvním spuštění (bez hesla se vygeneruje a vypíše do logu)
GORALIA_ADMIN_NAME=
GORALIA_ADMIN_EMAIL=
GORALIA_ADMIN_PASSWORD=

# Složky s daty (účty, statistiky) a mapami; výchozí data/ a maps/ v kořeni projektu (v Dockeru se nepoužijí)
GORALIA_DATA_DIR=
GORALIA_MAPS_DIR=
# GeoIP databáze pro mapu připojení (výchozí data/geoip.mmdb)
GORALIA_GEOIP=
# Časové pásmo statistik návštěvnosti
GORALIA_TZ=Europe/Prague

# Hlasový chat: STUN servery oddělené čárkou (výchozí stun:stun.l.google.com:19302)
GORALIA_STUN_URLS=
# Vlastní TURN server pro hráče za přísným NATem, např. turn:goralia.cz:3478
GORALIA_TURN_URL=
GORALIA_TURN_USER=
GORALIA_TURN_PASS=

# Jen pro `npm run voices` (výroba hlášek jednotek)
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
